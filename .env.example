# Public base URL of the app. Used for canonical links, OAuth redirects and email links.
# Local: http://localhost:3100. Production: your custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase project URL. Supabase dashboard -> Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key. Safe to expose to the browser; RLS enforces access.
# Supabase dashboard -> Project Settings -> API -> Project API keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key. Used for privileged jobs (never import into client code).
# Supabase dashboard -> Project Settings -> API -> service_role. Optional in this deployment:
# the seed and reports run with user sessions, so the demo works without it.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed by tooling that signs JWTs locally, e.g. legacy Supabase CLI workflows.
SUPABASE_JWT_SECRET=
# Private storage bucket for generated reports.
SUPABASE_STORAGE_BUCKET_REPORTS=reports
# Optional Redis-compatible URL for distributed rate limiting. Falls back to an in-memory
# sliding window per server instance when unset.
RATE_LIMIT_REDIS_URL=
# Optional Resend API key for invite, contact confirmation and digest email.
RESEND_API_KEY=
# FX rates provider. Only Frankfurter is bundled and it needs no key; any other
# value without an adapter makes the FX pages fail loudly instead of showing stale rates.
FX_PROVIDER=frankfurter
FX_BASE_URL=
FX_API_KEY=
# Optional Google Analytics measurement id.
NEXT_PUBLIC_GA_ID=
# Stamped on every scored transaction; bump when weights or signals change.
SCORING_MODEL_VERSION=v1
# AI analyst. Server-only key for River (https://api.river.ai); never exposed to the browser.
# The analyst answers only from aggregates the server retrieves for the selected window.
RIVER_API_KEY=
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
